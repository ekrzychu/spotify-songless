generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model GameTrack {
  id                     String                    @id @default(cuid())
  spotifyTrackId         String                    @unique
  spotifyUri             String
  isrc                   String?
  title                  String
  artistNames            String
  artistsJson            String
  albumName              String
  releaseDate            String?
  streamCount            BigInt?
  difficulty             String?
  soundchartsUuid        String?
  soundchartsReleaseDate String?
  soundchartsGenresJson  String?
  streamCountSource      String?
  streamCountUpdatedAt   DateTime?
  playable               Boolean                   @default(true)
  gameEligible           Boolean                   @default(true)
  spotifyUrl             String
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  categories             TrackCategory[]
  rounds                 GameRound[]
  unavailableIn          SessionUnavailableTrack[]

  @@index([difficulty, playable])
  @@index([isrc])
}

model SessionUnavailableTrack {
  sessionId String
  trackId   String
  createdAt DateTime  @default(now())
  track     GameTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([sessionId, trackId])
  @@index([sessionId, createdAt])
}

model TrackCategory {
  trackId                  String
  categoryId               String
  gameEligible             Boolean   @default(true)
  gameEligibilitySource    String?
  gameEligibilityUpdatedAt DateTime?
  track                    GameTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([trackId, categoryId])
  @@index([categoryId])
  @@index([categoryId, gameEligible])
}

model GameRound {
  id         String         @id @default(cuid())
  sessionId  String
  trackId    String
  attempt    Int            @default(0)
  finished   Boolean        @default(false)
  won        Boolean        @default(false)
  categoryId String
  difficulty String
  createdAt  DateTime       @default(now())
  finishedAt DateTime?
  track      GameTrack      @relation(fields: [trackId], references: [id])
  attempts   RoundAttempt[]

  @@index([sessionId, createdAt])
}

model RoundAttempt {
  id           String    @id @default(cuid())
  roundId      String
  number       Int
  outcome      String
  guessTrackId String?
  guessTitle   String?
  guessArtists String?
  createdAt    DateTime  @default(now())
  round        GameRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, number])
}
